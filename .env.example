# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (PostgreSQL connection string, e.g. from Neon/Supabase/RDS)
# Leave unset to fall back to local SQLite for offline development.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Razorpay API Credentials
# Get your Key ID and Key Secret from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretKeyHere

# Store Details
STORE_PHONE=+91 1234567890
STORE_EMAIL=support@greenpulsemobiles.in
